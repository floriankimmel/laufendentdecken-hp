{
  "name": "laufendentdecken",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter \"./apps/*\" dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build",
    "build:frontend": "pnpm --filter frontend build",
    "build:backend": "pnpm --filter backend build",
    "lint": "pnpm --filter frontend lint",
    "test": "pnpm --filter frontend test",
    "check": "pnpm check:lint && pnpm check:prettier",
    "check:lint": "pnpm --filter frontend lint",
    "check:prettier": "pnpm --filter frontend exec prettier --check .",
    "fix": "pnpm fix:lint && pnpm fix:prettier",
    "fix:lint": "pnpm --filter frontend lint:fix",
    "fix:prettier": "pnpm --filter frontend exec prettier -w ."
  },
  "engines": {
    "node": "^22.0.0"
  },
  "packageManager": "pnpm@10.19.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "@vercel/speed-insights",
      "esbuild",
      "sharp"
    ]
  }
}
