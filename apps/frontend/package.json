{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "scripts": {
    "astro": "astro",
    "build": "astro check && astro build --remote",
    "db:seed": "bun astro db execute db/seed.ts --remote",
    "dev": "astro dev",
    "format": "prettier -w .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "preview": "astro preview",
    "start": "astro dev",
    "test": "concurrently \"bun:test:*(!fix)\" --names \"test:\"",
    "test:e2e": "bun x playwright test",
    "test:unit": "vitest"
  },
  "dependencies": {
    "@astrojs/db": "^0.18.1",
    "@astrojs/node": "^9.5.1",
    "@astrojs/preact": "^4.1.1",
    "@astrojs/vercel": "^8.2.11",
    "@preact/signals": "^2.3.2",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "astro": "^5.15.0",
    "astro-seo-schema": "^5.1.0",
    "atropos": "^2.0.2",
    "he": "^1.2.0",
    "html-to-text": "^9.0.5",
    "preact": "^10.27.2",
    "rss-to-json": "^2.1.1",
    "schema-dts": "^1.1.5",
    "sharp": "^0.34.4",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@astrojs/sitemap": "^3.6.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@types/he": "^1.2.3",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.9.1",
    "@typescript-eslint/parser": "^8.46.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.38.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.4.0",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.1.44"
}
