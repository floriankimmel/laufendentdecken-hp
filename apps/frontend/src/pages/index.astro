---
import Layout from '../layouts/Layout.astro';
import EpisodeList from '../components/EpisodeList.astro';
import LoadMoreEpisodes from '../components/LoadMoreEpisodes';
import { getAllEpisodes, getShowInfo } from '../lib/rss';
const allEpisodes = await getAllEpisodes();
const episodes = allEpisodes.slice(0, 15);
const show = await getShowInfo();
const title = `${show.title}`;
const hasMore = allEpisodes.length > 15;
---

<Layout title={title}>
  <div class="relative z-10 px-8 lg:px-18">
    <h1 class="text-light-text-heading text-4xl font-bold dark:text-white">
      Episoden
    </h1>

    <ul aria-label="EpisodeList">
      <EpisodeList episodes={episodes} show={show} />
      {
        hasMore && (
          <LoadMoreEpisodes client:visible initialPage={2} show={show} />
        )
      }
    </ul>
  </div>
</Layout>
